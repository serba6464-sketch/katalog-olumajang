rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'serba6262@gmail.com' ||
        request.auth.token.email == 'admin@olumajang.com' ||
        (request.auth.token.firebase.sign_in_provider == 'anonymous' && request.auth.uid != null)
      );
    }

    // Warung Logo
    match /warungs/{warungId}/logo/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Warung Photo Menu (Maksimal 60 foto per warung, dikompres max 1200px)
    match /warungs/{warungId}/photos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
